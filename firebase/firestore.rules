rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 24;
    }

    function optionalReplyKeys() {
      return request.resource.data.keys().hasAll(['replyToId', 'replyToText', 'replyToAuthorName'])
        && request.resource.data.replyToId is string
        && request.resource.data.replyToId.size() > 0
        && request.resource.data.replyToId.size() <= 128
        && request.resource.data.replyToText is string
        && request.resource.data.replyToText.size() <= 200
        && request.resource.data.replyToAuthorName is string
        && request.resource.data.replyToAuthorName.size() >= 1
        && request.resource.data.replyToAuthorName.size() <= 64;
    }

    function baseAuthorOk() {
      return request.resource.data.authorId == request.auth.uid
        && validName(request.resource.data.authorName)
        && request.resource.data.createdAt == request.time;
    }

    // Optional write-time avatar snapshot on new messages only.
    function optionalAuthorPhotoURL() {
      return !('authorPhotoURL' in request.resource.data)
        || (request.resource.data.authorPhotoURL is string
            && request.resource.data.authorPhotoURL.size() >= 8
            && request.resource.data.authorPhotoURL.size() <= 2048
            && request.resource.data.authorPhotoURL.matches('https://.*'));
    }

    // Keys must be a subset of [required ∪ optional], and include all required.
    function keysWithin(allowed) {
      return request.resource.data.keys().toSet().difference(allowed.toSet()).size() == 0;
    }

    function isTextMessage() {
      return request.resource.data.keys().hasAll(['text', 'authorId', 'authorName', 'createdAt'])
        && keysWithin([
             'text', 'authorId', 'authorName', 'createdAt', 'messageKind',
             'replyToId', 'replyToText', 'replyToAuthorName', 'authorPhotoURL'
           ])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && (
          !('messageKind' in request.resource.data)
          || request.resource.data.messageKind == 'text'
        )
        && optionalAuthorPhotoURL()
        && (!('replyToId' in request.resource.data) || optionalReplyKeys());
    }

    function isAllowedMediaUrl(path) {
      return path.matches(
             'https://pub-7c910bfa4a884bb6bd039db548455d5e\\.r2\\.dev/threads/[A-Za-z0-9_-]{1,128}/[A-Za-z0-9_-]{1,128}\\.(jpg|m4a|mp4)'
           )
        || path.matches('https://firebasestorage\\.googleapis\\.com/.*');
    }

    function isImageMessage() {
      return request.resource.data.keys().hasAll([
             'text', 'authorId', 'authorName', 'createdAt',
             'messageKind', 'imagePath', 'imageWidth', 'imageHeight'
           ])
        && keysWithin([
             'text', 'authorId', 'authorName', 'createdAt',
             'messageKind', 'imagePath', 'imageWidth', 'imageHeight',
             'replyToId', 'replyToText', 'replyToAuthorName', 'authorPhotoURL'
           ])
        && request.resource.data.messageKind == 'image'
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.imagePath is string
        && request.resource.data.imagePath.size() > 0
        && request.resource.data.imagePath.size() <= 2048
        && isAllowedMediaUrl(request.resource.data.imagePath)
        && request.resource.data.imageWidth is number
        && request.resource.data.imageHeight is number
        && request.resource.data.imageWidth > 0
        && request.resource.data.imageHeight > 0
        && optionalAuthorPhotoURL()
        && (!('replyToId' in request.resource.data) || optionalReplyKeys());
    }

    function isVoiceMessage() {
      return request.resource.data.keys().hasAll([
             'text', 'authorId', 'authorName', 'createdAt',
             'messageKind', 'audioPath', 'audioDurationMs'
           ])
        && keysWithin([
             'text', 'authorId', 'authorName', 'createdAt',
             'messageKind', 'audioPath', 'audioDurationMs',
             'replyToId', 'replyToText', 'replyToAuthorName', 'authorPhotoURL'
           ])
        && request.resource.data.messageKind == 'voice'
        && request.resource.data.text is string
        && request.resource.data.text.size() == 0
        && request.resource.data.audioPath is string
        && request.resource.data.audioPath.size() > 0
        && request.resource.data.audioPath.size() <= 2048
        && isAllowedMediaUrl(request.resource.data.audioPath)
        && request.resource.data.audioDurationMs is number
        && request.resource.data.audioDurationMs > 0
        && request.resource.data.audioDurationMs <= 60000
        && optionalAuthorPhotoURL()
        && (!('replyToId' in request.resource.data) || optionalReplyKeys());
    }

    function isVideoMessage() {
      return request.resource.data.keys().hasAll([
             'text', 'authorId', 'authorName', 'createdAt',
             'messageKind', 'videoPath', 'videoDurationMs',
             'videoWidth', 'videoHeight'
           ])
        && keysWithin([
             'text', 'authorId', 'authorName', 'createdAt',
             'messageKind', 'videoPath', 'videoDurationMs',
             'videoWidth', 'videoHeight',
             'replyToId', 'replyToText', 'replyToAuthorName', 'authorPhotoURL'
           ])
        && request.resource.data.messageKind == 'video'
        // Caption optional — clients (esp. Android) attach text like image messages.
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.videoPath is string
        && request.resource.data.videoPath.size() > 0
        && request.resource.data.videoPath.size() <= 2048
        && isAllowedMediaUrl(request.resource.data.videoPath)
        && request.resource.data.videoDurationMs is number
        && request.resource.data.videoDurationMs > 0
        && request.resource.data.videoDurationMs <= 30000
        && request.resource.data.videoWidth is number
        && request.resource.data.videoHeight is number
        && request.resource.data.videoWidth > 0
        && request.resource.data.videoHeight > 0
        && optionalAuthorPhotoURL()
        && (!('replyToId' in request.resource.data) || optionalReplyKeys());
    }

    function isStickerMessage() {
      return request.resource.data.keys().hasAll([
             'text', 'authorId', 'authorName', 'createdAt', 'messageKind'
           ])
        && keysWithin([
             'text', 'authorId', 'authorName', 'createdAt', 'messageKind',
             'replyToId', 'replyToText', 'replyToAuthorName', 'authorPhotoURL'
           ])
        && request.resource.data.messageKind == 'sticker'
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 8
        && optionalAuthorPhotoURL()
        && (!('replyToId' in request.resource.data) || optionalReplyKeys());
    }

    // Reaction toggles only — emoji → list of uids. Clients keep one emoji per user.
    function isReactionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions is map
        && request.resource.data.reactions.size() <= 12;
    }

    // Author edits text (plain message) or image caption. Media paths stay immutable.
    function isOwnMessageEdit() {
      return resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['text', 'editedAt'])
        && request.resource.data.editedAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (
          (
            (!('messageKind' in resource.data) || resource.data.messageKind == 'text')
            && request.resource.data.text.size() >= 1
          )
          || (
            resource.data.messageKind == 'image'
          )
        );
    }

    function isTipIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessageAt', 'messageCount', 'lastMediaPath', 'lastMediaKind'])
        && request.resource.data.messageCount == resource.data.messageCount + 1
        && request.resource.data.lastMessageAt == request.time
        && lastMediaPreviewOk();
    }

    // After deleting a message: count goes down; tip fields may be recomputed.
    function isTipRewind() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.messageCount is int
        && request.resource.data.messageCount >= 0
        && request.resource.data.messageCount == resource.data.messageCount - 1
        && (
          keys.hasOnly(['messageCount'])
          || (
            keys.hasOnly(['lastMessageAt', 'messageCount', 'lastMediaPath', 'lastMediaKind'])
            && request.resource.data.lastMessageAt is timestamp
            && lastMediaPreviewOk()
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'displayName', 'photoURL', 'photoPath', 'createdAt', 'updatedAt'
           ])
        && (!('displayName' in request.resource.data)
            || validName(request.resource.data.displayName))
        && (!('photoURL' in request.resource.data)
            || request.resource.data.photoURL is string)
        && (!('photoPath' in request.resource.data)
            || request.resource.data.photoPath is string);
      // Account deletion — own profile only. Subcollections deleted by the client first.
      allow delete: if signedIn() && request.auth.uid == userId;

      // Private block list — hides that author's threads and messages for this viewer.
      match /blocks/{blockedUid} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && blockedUid == request.resource.data.blockedUid
          && blockedUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['blockedUid', 'displayName', 'createdAt'])
          && request.resource.data.blockedUid is string
          && request.resource.data.blockedUid.size() >= 1
          && request.resource.data.blockedUid.size() <= 128
          && validName(request.resource.data.displayName)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // Append-only reports owned by the reporter (admin can query collection-group later).
      match /reports/{reportId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
               'targetType', 'targetId', 'threadId', 'targetAuthorId', 'reason', 'createdAt'
             ])
          && request.resource.data.targetType in ['message', 'thread', 'user']
          && request.resource.data.targetId is string
          && request.resource.data.targetId.size() >= 1
          && request.resource.data.targetId.size() <= 128
          && request.resource.data.threadId is string
          && request.resource.data.threadId.size() <= 128
          && request.resource.data.targetAuthorId is string
          && request.resource.data.targetAuthorId.size() >= 1
          && request.resource.data.targetAuthorId.size() <= 128
          && request.resource.data.targetAuthorId != request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'other']
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.targetType == 'message'
              && request.resource.data.threadId.size() >= 1)
            || (request.resource.data.targetType != 'message'
              && request.resource.data.threadId.size() == 0)
          );
        allow update, delete: if false;
      }

      // FCM device tokens for this user (doc id = stable device id).
      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 8
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    function lastMediaPreviewOk() {
      let data = request.resource.data;
      let hasPath = 'lastMediaPath' in data;
      let hasKind = 'lastMediaKind' in data;
      return (!hasPath && !hasKind)
        || (
          hasPath && hasKind
          && data.lastMediaKind in ['image', 'video']
          && data.lastMediaPath is string
          && data.lastMediaPath.size() > 0
          && data.lastMediaPath.size() <= 2048
          && isAllowedMediaUrl(data.lastMediaPath)
        );
    }

    match /threads/{threadId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
             'title', 'kind', 'lat', 'lng', 'geohash',
             'authorId', 'authorName', 'createdAt', 'lastMessageAt', 'messageCount'
           ])
        && request.resource.data.keys().hasOnly([
             'title', 'kind', 'lat', 'lng', 'geohash',
             'authorId', 'authorName', 'createdAt', 'lastMessageAt', 'messageCount'
           ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.kind in ['event', 'notice', 'traffic', 'general']
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.geohash is string
        && request.resource.data.geohash.size() > 0
        && request.resource.data.geohash.size() <= 12
        && validName(request.resource.data.authorName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.messageCount == 0;

      allow update: if signedIn() && (isTipIncrement() || isTipRewind());

      // Thread starter can remove the chat (client deletes messages + subscribers first).
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && baseAuthorOk()
          && (isTextMessage() || isImageMessage() || isVoiceMessage() || isVideoMessage() || isStickerMessage());

        allow update: if signedIn() && (isReactionUpdate() || isOwnMessageEdit());

        // Own message, or the chat starter wiping the thread.
        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/threads/$(threadId)).data.authorId
               == request.auth.uid
        );
      }

      // Auto-subscribed when the user opens or posts in a thread.
      match /subscribers/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['subscribedAt'])
          && request.resource.data.subscribedAt == request.time;
        // Own unsubscribe, or chat starter deleting the thread.
        allow delete: if signedIn() && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/threads/$(threadId)).data.authorId
               == request.auth.uid
        );
      }
    }
  }
}
