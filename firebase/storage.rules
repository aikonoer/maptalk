rules_version = '2';

// Compressed JPEG chat photos. Swap this bucket for Cloudflare R2 later if egress
// becomes the cost driver; the clients already store a public HTTPS URL in imagePath.
service firebase.storage {
  match /b/{bucket}/o {
    match /threads/{threadId}/{messageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }
  }
}
