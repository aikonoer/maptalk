<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Debug builds talk to the Firebase emulators on the Mac over plain HTTP.
	  The USB debug link uses 192.0.0.2, which is not an RFC1918 LAN address, so
	  NSAllowsLocalNetworking alone is not enough — carve out an exception.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>192.0.0.2</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MapTalk reaches the Firebase emulators on your Mac when you run with mock data.</string>
	<!-- Expanded from the MAPTALK_MODE build setting (local / live). -->
	<key>MapTalkMode</key>
	<string>$(MAPTALK_MODE)</string>
</dict>
</plist>
