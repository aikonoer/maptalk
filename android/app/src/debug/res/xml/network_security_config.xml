<?xml version="1.0" encoding="utf-8"?>
<!--
  The Firebase emulators speak plain HTTP, and the AVD reaches the host machine at 10.0.2.2.
  This lives in the debug source set only, so release builds keep cleartext turned off.
  Used by the cross-device suite; see scripts/cross-device-qa.sh.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
