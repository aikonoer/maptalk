<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Colours live in Compose; this only styles the window before the first frame. The app is
         dark whatever the system setting is, so there is no -night variant. -->
    <style name="Theme.MapTalk" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
